{
  "name": "personal-ca-server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "sample-pdfs": "tsx scripts/sample-pdfs.ts",
    "phone": "tsx scripts/phone.ts",
    "build:exe": "tsx scripts/build-exe.ts",
    "scan": "tsx scripts/scan.ts",
    "verify": "tsc --noEmit && tsc --noEmit -p ../mobile/tsconfig.json && vitest run && tsx scripts/scan.ts",
    "build:vercel": "tsx scripts/build-vercel.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@vercel/blob": "^2.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "^0.28.2",
    "pdfkit": "^0.20.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
