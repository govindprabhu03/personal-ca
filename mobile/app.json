{
  "expo": {
    "name": "Personal CA",
    "slug": "personal-ca",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F2FF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.govindprabhu.personalca",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Personal CA with Face ID"
      }
    },
    "android": {
      "package": "com.govindprabhu.personalca",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F6F2FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "85e92ac8-f9be-4c10-9b6e-2c9a63fe063e"
      }
    },
    "owner": "govindprabhu03"
  }
}
